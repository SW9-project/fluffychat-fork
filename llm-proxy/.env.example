# Copy to .env on the server and fill in. Never commit .env.

# --- Providers (keys live only here) ---------------------------------------
# Free key from https://console.groq.com/keys
GROQ_API_KEY=

# --- Synapse ---------------------------------------------------------------
# Synapse as the proxy reaches it on the Docker network, not the public URL.
# The listener must serve the "openid" (or "federation") resource.
SYNAPSE_URL=http://synapse:8008
# Your homeserver's server_name (the part after ":" in @user:server_name).
HOMESERVER_NAME=

# --- Privacy ---------------------------------------------------------------
# Secret salt for hashing user IDs in logs. At least 16 characters, e.g.
#   openssl rand -hex 32
LOG_SALT=
# Opt-in for the user study: also log the user's Assist prompt text.
# Only turn on when the study's consent covers it. Default: off.
STUDY_LOGGING=false

# --- Limits ----------------------------------------------------------------
PORT=8080
RATE_LIMIT_PER_MIN=10
AUTH_CACHE_TTL_S=60
TOKEN_BUDGET_WARN=2500
MAX_TOKENS=300

# --- Evaluation only ---------------------------------------------------------
# Lets the X-Assist-Provider header pick one provider. Keep false in production.
ALLOW_PROVIDER_OVERRIDE=false

# Name of Synapse's Docker network (docker-compose.yml joins it).
SYNAPSE_NETWORK=synapse
